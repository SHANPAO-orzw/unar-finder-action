#!/bin/bash
set -e
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
stage="$(mktemp -d "${TMPDIR:-/tmp}/unar-install.XXXXXXXX")"
trap 'rm -rf "$stage"' EXIT
base64 -D > "$stage/latest.zip" <<'UNAR_PAYLOAD'

UNAR_PAYLOAD
ditto -x -k "$stage/latest.zip" "$stage/unpacked"
source_workflow="$stage/unpacked/解压到当前文件夹.workflow"
plutil -lint "$source_workflow/Contents/document.wflow" >/dev/null
services="$HOME/Library/Services"
backup="$HOME/Library/Application Support/unar快速操作备份/$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$services" "$backup"
for name in '解压到当前文件夹.workflow' '解压到当前文件夹 2.workflow'; do
    if [ -e "$services/$name" ] || [ -L "$services/$name" ]; then
        mv "$services/$name" "$backup/$name"
    fi
done
if ! ditto "$source_workflow" "$services/解压到当前文件夹.workflow"; then
    rm -rf "$services/解压到当前文件夹.workflow"
    for name in '解压到当前文件夹.workflow' '解压到当前文件夹 2.workflow'; do
        [ ! -e "$backup/$name" ] || mv "$backup/$name" "$services/$name"
    done
    echo '安装失败，已恢复旧版本。'
    exit 1
fi
/System/Library/CoreServices/pbs -update >/dev/null 2>&1 || true
echo '已完成：两个旧入口已移至备份，只保留一个最新的“解压到当前文件夹”。'
echo "备份位置：$backup"
echo '请重新打开访达右键菜单查看。现在可以关闭此终端窗口。'
