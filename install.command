#!/bin/bash
set -e
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
if [ ! -x /opt/homebrew/bin/unar ] || [ ! -x /opt/homebrew/bin/lsar ]; then
    echo '还没有找到 unar。请先在终端执行：brew install unar'
    echo '安装完成后，再双击这个安装器。本版本适用于 M 系列芯片 Mac。'
    exit 1
fi
stage="$(mktemp -d "${TMPDIR:-/tmp}/unar-install.XXXXXXXX")"
trap 'rm -rf "$stage"' EXIT
base64 -D > "$stage/workflow.zip" <<'UNAR_PAYLOAD'

UNAR_PAYLOAD
ditto -x -k "$stage/workflow.zip" "$stage/unpacked"
source_workflow="$stage/unpacked/解压到当前文件夹.workflow"
plutil -lint "$source_workflow/Contents/document.wflow" >/dev/null
services="$HOME/Library/Services"
target="$services/解压到当前文件夹.workflow"
backup=""
mkdir -p "$services"
if [ -e "$target" ] || [ -L "$target" ]; then
    backup="$HOME/Library/Application Support/unar-finder-action/Backups/$(date +%Y%m%d-%H%M%S)-$$"
    mkdir -p "$backup"
    mv "$target" "$backup/解压到当前文件夹.workflow"
fi
if ! ditto "$source_workflow" "$target"; then
    rm -rf "$target"
    if [ -n "$backup" ]; then
        mv "$backup/解压到当前文件夹.workflow" "$target"
    fi
    echo '安装没有完成，已恢复原来的版本。'
    exit 1
fi
/System/Library/CoreServices/pbs -update >/dev/null 2>&1 || true
echo ''
echo '安装完成！'
echo '现在可以在访达右键点击压缩包 → 快速操作 → 解压到当前文件夹。'
echo '遇到密码窗口时，输入压缩包密码即可。'
echo '这个终端窗口现在可以关闭了。'
